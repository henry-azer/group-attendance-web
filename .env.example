# Public Supabase project config (used by the frontend at build/dev time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local-only direct Postgres connection string, used by db:migrate / db:test.
# Never referenced by frontend code; never committed.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
